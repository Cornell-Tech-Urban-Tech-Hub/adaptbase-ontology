{
  "@context": {
    "@version": 1.1,
    "ab": "https://ontology.adaptbase.us/ont/",
    "abv": "https://ontology.adaptbase.us/vocab/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "dcterms": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "ab:localId",
    "label": "rdfs:label",
    "definition": "rdfs:comment",
    "description": "rdfs:comment",
    "notes": "ab:designNotes",
    "extract_hint": "ab:extractionHint",

    "types": { "@id": "ab:definesClass", "@container": "@set" },
    "relationships": { "@id": "ab:definesProperty", "@container": "@set" },
    "vocabularies": { "@id": "ab:definesVocabulary", "@container": "@set" },

    "properties": { "@id": "ab:hasProperty", "@container": "@set" },
    "required": "ab:required",
    "type": "ab:kind",
    "values": { "@id": "ab:allowedValues", "@container": "@set" },
    "note": "ab:note",

    "vocabulary": "ab:boundToVocabularyName",
    "vocabulary_binding": "ab:vocabularyBinding",
    "vocabulary_bindings": { "@id": "ab:vocabularyBindings", "@container": "@set" },
    "vocab": "ab:vocabId",
    "field": "ab:fieldName",

    "source": "ab:sourceTypeName",
    "target": "ab:targetTypeName",
    "cardinality": "ab:cardinality",

    "claim_ids": { "@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set" },

    "version": "dcterms:hasVersion",
    "updated": { "@id": "dcterms:modified", "@type": "xsd:dateTime" },
    "update_note": "ab:updateNote",
    "domain": "dcterms:subject",
    "domain_label": "ab:domainLabel",
    "metadata": "ab:metadata",
    "version_notes": { "@id": "ab:versionNotes", "@container": "@set" },
    "change_history": { "@id": "ab:changeHistory", "@container": "@set" },
    "types_count": "ab:typesCount",
    "relationships_count": "ab:relationshipsCount",
    "vocabularies_count": "ab:vocabulariesCount",
    "summary": "rdfs:comment",
    "changes": { "@id": "ab:changeEntry", "@container": "@set" },

    "url": "ab:sourceUrl",
    "bound_to": { "@id": "ab:boundToField", "@container": "@set" },
    "terms_count": "ab:termsCount",

    "schema_source": "ab:schemaSource",
    "evidence_cases": { "@id": "ab:evidenceCases", "@container": "@set" },

    "categories": { "@id": "ab:hasCategory", "@container": "@set" },
    "subcategories": { "@id": "ab:hasSubcategory", "@container": "@set" },
    "hazards": { "@id": "ab:hasHazard", "@container": "@set" },
    "dimensions": { "@id": "ab:hasDimension", "@container": "@set" },
    "goals": { "@id": "ab:hasGoal", "@container": "@set" },
    "sectors": { "@id": "ab:hasSector", "@container": "@set" },
    "subsectors": { "@id": "ab:hasSubsector", "@container": "@set" },
    "systems": { "@id": "ab:hasSystem", "@container": "@set" },
    "populations": { "@id": "ab:hasPopulation", "@container": "@set" },
    "terms": { "@id": "ab:hasTerm", "@container": "@set" },
    "mappings": { "@id": "ab:hasMapping", "@container": "@set" },
    "hazard_ids": { "@id": "ab:hazardIds", "@container": "@set" },
    "match_type": "ab:matchType",
    "cdp_value": "ab:cdpValue",
    "examples": "ab:examples",
    "framework_mappings": "ab:frameworkMappings",
    "hips_2025_cluster": "ab:hipsCluster",
    "c40_arup_categories": { "@id": "ab:c40ArupCategories", "@container": "@set" },
    "c40_arup_category": "ab:c40ArupCategory",
    "rcc_shocks": { "@id": "ab:rccShocks", "@container": "@set" },
    "hazard_source": "ab:hazardSource",
    "undrr_terms": { "@id": "ab:undrrTerms", "@container": "@set" },
    "dimension": "ab:dimension",
    "ipcc_ar6": "ab:ipccAr6",
    "undrr": "ab:undrr",
    "excluded_values": { "@id": "ab:excludedValues", "@container": "@set" },
    "write_in_values": "ab:writeInValues",
    "known_gaps": { "@id": "ab:knownGaps", "@container": "@set" },
    "reason": "ab:reason",
    "_source": "dcterms:source",
    "_usage": "ab:usageNote",
    "_sync_with": "ab:syncWith",
    "_note": "ab:note"
  }
}
