  "instrument_type": {
    "_source": "CDP project finance vocabulary, extended in v0.2 with US municipal CIP terms",
    "_usage": "FinancialInstrument.instrument_type",
    "_note": "v0.2: extended with US municipal CIP language (general_obligation_bond, revenue_bond, tax_increment_financing, special_assessment, federal_cost_share, state_cost_share, municipal_capital_appropriation, ratepayer_funded). All previous values retained.",
    "values": [
      {
        "id": "green_bond",
        "name": "Green Bond",
        "description": "Municipal or corporate green bond",
        "@id": "abv:enums-instrument_type-green_bond",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "general_obligation_bond",
        "name": "General Obligation Bond",
        "description": "Municipal bond backed by the full faith and credit (and taxing power) of the issuing government. Per Salkin: 'no one is using this' for resilience — opportunity area.",
        "@id": "abv:enums-instrument_type-general_obligation_bond",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "revenue_bond",
        "name": "Revenue Bond",
        "description": "Municipal bond backed by revenues from a specific source (water rates, tolls, etc.). Includes enterprise/ratepayer-supported financing.",
        "@id": "abv:enums-instrument_type-revenue_bond",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "tax_increment_financing",
        "name": "Tax Increment Financing (TIF)",
        "description": "Bond or special-district financing repaid from the future incremental tax revenue generated by improvements in a defined area",
