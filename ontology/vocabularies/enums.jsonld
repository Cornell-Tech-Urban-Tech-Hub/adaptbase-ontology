  "value_recurrence": {
    "_source": "Standard benefit-cost analysis recurrence categories",
    "_usage": "Outcome.value_recurrence",
    "_note": "v0.2: introduced. Distinguishes one-time avoided losses from recurring annual benefits from lifetime-integrated value, so that monetized_value_usd can be interpreted correctly.",
    "values": [
      {
        "id": "one_time",
        "name": "One-time",
        "description": "Lump-sum value (e.g., avoided damages from a single hazard event)",
        "@id": "abv:enums-value_recurrence-one_time",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-value_recurrence"
        }
      },
      {
        "id": "annual",
        "name": "Annual",
        "description": "Recurring per-year value (e.g., reduced stormwater treatment cost)",
        "@id": "abv:enums-value_recurrence-annual",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-value_recurrence"
        }
      },
      {
        "id": "lifetime",
        "name": "Lifetime",
        "description": "Value integrated over the asset's useful life",
        "@id": "abv:enums-value_recurrence-lifetime",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-value_recurrence"
        }
      }
    ],
    "@id": "abv:enums-value_recurrence",
    "@type": "skos:ConceptScheme"
  },
