          "@id": "abv:enums-outcome_type"
        }
      },
      {
        "id": "maladaptation",
        "name": "Maladaptation",
        "description": "The solution worked as intended but transferred or increased risk elsewhere",
        "@id": "abv:enums-outcome_type-maladaptation",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-outcome_type"
