  "mechanism_vocabulary": {
    "_description": "Authoritative controlled vocabulary for mechanism dimension (v0.3 — upgraded from guidance-only seed). Extractors must use these values; use 'other' + free-text for outliers.",
    "_usage": "mechanisms.primary_mechanism.value, mechanisms.secondary_mechanisms[].value",
    "_note": "v0.3: added restore, relocate, buffer, insulate, regulate + other. Status changed from guidance-only to authoritative. Sprint 4: added sense_and_detect, forecast_and_model, automate_and_control, inform_and_alert. 'monitor' is retained for general observation but now complemented by more specific digital-process types. See decisions-log.md §15.",
    "values": [
      {
        "id": "absorb",
        "name": "Absorb",
        "description": "Buffer, attenuate, or absorb the impact (e.g., green infrastructure absorbing stormwater)",
        "@id": "abv:enums-mechanism_vocabulary-absorb",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "redirect",
        "name": "Redirect",
        "description": "Divert, channel, or redistribute the hazard (e.g., flood channels, drainage rerouting)",
        "@id": "abv:enums-mechanism_vocabulary-redirect",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "harden",
        "name": "Harden",
        "description": "Strengthen, fortify, or protect against impact (e.g., building hardening, seawalls)",
        "@id": "abv:enums-mechanism_vocabulary-harden",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "monitor",
        "name": "Monitor",
        "description": "Observe, measure, or track conditions over time without automated response (e.g., manual sensor readings, periodic surveys, environmental monitoring programs)",
        "@id": "abv:enums-mechanism_vocabulary-monitor",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "govern",
        "name": "Govern",
        "description": "Regulate, plan, coordinate, or incentivize (e.g., building codes, zoning, carbon pricing)",
        "@id": "abv:enums-mechanism_vocabulary-govern",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "shift_risk",
        "name": "Shift Risk",
        "description": "Transfer, insure, or redistribute risk (e.g., parametric insurance, risk pooling)",
        "@id": "abv:enums-mechanism_vocabulary-shift_risk",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "adapt_behavior",
        "name": "Adapt Behavior",
        "description": "Change practices, educate, or build awareness (e.g., demand response, heat action behavior campaigns)",
        "@id": "abv:enums-mechanism_vocabulary-adapt_behavior",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "restore_regenerate",
        "name": "Restore/Regenerate",
        "description": "Rehabilitate, restore, or regenerate natural or built systems (e.g., ecosystem restoration, urban forest regeneration)",
        "@id": "abv:enums-mechanism_vocabulary-restore_regenerate",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "restore",
        "name": "Restore",
        "description": "Bring a degraded ecosystem or system back to a prior functional state (e.g., wetland restoration, riparian zone recovery). Use when restoration is the primary mechanism, distinct from broader regeneration.",
        "@id": "abv:enums-mechanism_vocabulary-restore",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "relocate",
        "name": "Relocate",
        "description": "Move people, assets, or infrastructure away from the hazard zone (e.g., managed retreat, infrastructure relocation out of flood plains)",
        "@id": "abv:enums-mechanism_vocabulary-relocate",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "buffer",
        "name": "Buffer",
        "description": "Create protective zones or transition spaces that reduce hazard intensity before it reaches assets (e.g., coastal buffer strips, urban green belts, windbreaks). Distinct from 'absorb' — buffering acts at a distance from the asset.",
        "@id": "abv:enums-mechanism_vocabulary-buffer",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "insulate",
        "name": "Insulate",
        "description": "Create thermal or physical barriers that prevent hazard transmission into a system (e.g., thermal insulation against heat, acoustic barriers, flood-proof walls on individual structures). Distinct from 'harden' — insulation prevents transmission rather than strengthening resistance.",
        "@id": "abv:enums-mechanism_vocabulary-insulate",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "regulate",
        "name": "Regulate",
        "description": "Apply rules, standards, permits, or enforcement mechanisms to control hazard-relevant behaviors or land use (e.g., floodplain zoning enforcement, emission limits, water use restrictions). More specific than 'govern' — focused on rule-based compliance mechanisms.",
        "@id": "abv:enums-mechanism_vocabulary-regulate",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "sense_and_detect",
        "name": "Sense and Detect",
        "description": "Actively sense environmental or system conditions and detect discrete events or threshold crossings using digital sensors, IoT devices, or remote sensing (e.g., flood sensors triggering alerts, wildfire detection cameras, structural health monitoring)",
        "@id": "abv:enums-mechanism_vocabulary-sense_and_detect",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "forecast_and_model",
        "name": "Forecast and Model",
        "description": "Use computational models, AI/ML, or simulation to produce forward-looking predictions or scenario analyses (e.g., hydrological models forecasting flood depth, digital twins simulating heat distribution, ML-based drought prediction)",
        "@id": "abv:enums-mechanism_vocabulary-forecast_and_model",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "automate_and_control",
        "name": "Automate and Control",
        "description": "Execute closed-loop machine actuation or automated system control in response to sensed conditions without requiring human decision in the loop (e.g., automated pump activation during storm events, DERMS load balancing, smart irrigation responding to soil moisture sensors)",
        "@id": "abv:enums-mechanism_vocabulary-automate_and_control",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "inform_and_alert",
        "name": "Inform and Alert",
        "description": "Disseminate information, warnings, or targeted communications to populations, responders, or decision-makers to trigger human action (e.g., heat-wave SMS alerts, early-warning broadcasts, real-time dashboard for emergency managers). Distinct from automate_and_control — the response is human.",
        "@id": "abv:enums-mechanism_vocabulary-inform_and_alert",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      },
      {
        "id": "other",
        "name": "Other",
        "description": "Mechanism not covered by the above values. Use with mechanism_other_description.",
        "@id": "abv:enums-mechanism_vocabulary-other",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-mechanism_vocabulary"
        }
      }
    ],
    "@id": "abv:enums-mechanism_vocabulary",
    "@type": "skos:ConceptScheme"
  },
