        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "sustainability_linked_loan",
        "name": "Sustainability-Linked Loan",
        "description": "Loan with sustainability performance targets",
        "@id": "abv:enums-instrument_type-sustainability_linked_loan",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "climate_bond",
        "name": "Climate Bond",
        "description": "Bond earmarked for climate projects",
        "@id": "abv:enums-instrument_type-climate_bond",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
