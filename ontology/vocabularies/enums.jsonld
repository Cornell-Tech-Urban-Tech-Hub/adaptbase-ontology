        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "municipal_capital_appropriation",
        "name": "Municipal Capital Appropriation",
        "description": "Direct appropriation from the city's own capital budget — 'pay-as-you-go' rather than bond-financed",
        "@id": "abv:enums-instrument_type-municipal_capital_appropriation",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "ratepayer_funded",
        "name": "Ratepayer Funded",
        "description": "Funded directly through utility rates (Salkin's 'enterprise/revenue-supported pass-through to ratepayers'). Distinct from revenue_bond — ratepayer_funded is current-revenue funding, not debt issuance secured by future ratepayer revenue.",
        "@id": "abv:enums-instrument_type-ratepayer_funded",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "direct_allocation",
        "name": "Direct Allocation",
        "description": "Direct public budget allocation without a structured instrument",
        "@id": "abv:enums-instrument_type-direct_allocation",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "outcome_bond",
        "name": "Outcome Bond",
        "description": "Bond whose repayment or interest rate is contingent on achieving measurable adaptation outcomes (e.g., flood damage avoidance, heat mortality reduction). Linked via CONTINGENT_ON relationship to Outcome nodes.",
        "@id": "abv:enums-instrument_type-outcome_bond",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "other",
