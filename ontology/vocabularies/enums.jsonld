  "justice_dimension": {
    "_source": "Shi (2024) equity rubric — four justice dimensions for climate adaptation outcomes",
    "_usage": "outcome.justice_dimension[]",
    "_note": "Applied to Outcome nodes to characterize what type of equity impact is documented. Multiple dimensions can apply to a single outcome. See decisions-log.md §16.",
    "values": [
      {
        "id": "distributive",
        "name": "Distributive",
        "description": "Who bears the costs and who receives the benefits — distributional fairness of outcomes and burdens",
        "@id": "abv:enums-justice_dimension-distributive",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-justice_dimension"
        }
      },
      {
        "id": "procedural",
        "name": "Procedural",
        "description": "Who participates in and shapes decisions — fairness of decision-making processes",
        "@id": "abv:enums-justice_dimension-procedural",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-justice_dimension"
        }
      },
      {
        "id": "recognitional",
        "name": "Recognitional",
        "description": "Whose knowledge, history, and lived experience are acknowledged and meaningfully incorporated",
        "@id": "abv:enums-justice_dimension-recognitional",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-justice_dimension"
        }
      },
      {
        "id": "epistemic",
        "name": "Epistemic",
        "description": "How knowledge is produced, what counts as valid evidence, and whose expertise is legitimized",
        "@id": "abv:enums-justice_dimension-epistemic",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-justice_dimension"
        }
      }
    ],
    "@id": "abv:enums-justice_dimension",
    "@type": "skos:ConceptScheme"
  },
