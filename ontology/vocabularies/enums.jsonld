  "accreditation_modality": {
    "_source": "Adaptation Fund (AF) and Green Climate Fund (GCF) access modalities for adaptation finance. Captures the institutional arrangement through which a financing source delivers capital to a project, distinct from the financing model (the structural form of the funds).",
    "_usage": "FinancingSource.accreditation_modality",
    "_note": "v0.1.1: added per peer review recommendation that AF/GCF terminology (NIEs, direct access, pooled facilities) be modeled. Belongs on FinancingSource — distinct from the operational mechanism_vocabulary, which describes how a Solution physically achieves adaptation effect.",
    "values": [
      {
        "id": "national_implementing_entity",
        "name": "National Implementing Entity (NIE)",
        "description": "AF/GCF-accredited entity within the recipient country with direct access to climate finance",
        "@id": "abv:enums-accreditation_modality-national_implementing_entity",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      },
      {
        "id": "regional_implementing_entity",
        "name": "Regional Implementing Entity (RIE)",
        "description": "AF/GCF-accredited regional entity (e.g., regional development bank) with direct access on behalf of multiple countries",
        "@id": "abv:enums-accreditation_modality-regional_implementing_entity",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      },
      {
        "id": "multilateral_implementing_entity",
        "name": "Multilateral Implementing Entity (MIE)",
        "description": "International accredited entity (UNDP, World Bank, regional MDBs) channeling AF/GCF funds — the international-access default",
        "@id": "abv:enums-accreditation_modality-multilateral_implementing_entity",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      },
      {
        "id": "direct_access",
        "name": "Direct Access",
        "description": "Recipient-country institution applies for and receives funds directly without an MIE intermediary",
        "@id": "abv:enums-accreditation_modality-direct_access",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      },
      {
        "id": "enhanced_direct_access",
        "name": "Enhanced Direct Access (EDA)",
        "description": "GCF modality devolving project-level decision-making to in-country accredited entities; deeper subsidiarity than baseline direct access",
        "@id": "abv:enums-accreditation_modality-enhanced_direct_access",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      },
      {
        "id": "pooled_facility",
        "name": "Pooled Facility",
        "description": "Multiple sources or instruments aggregated into a single funding facility serving a portfolio of projects (e.g., national climate funds, blended-finance vehicles)",
        "@id": "abv:enums-accreditation_modality-pooled_facility",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      },
      {
        "id": "readiness_programme",
        "name": "Readiness / Preparatory Support",
        "description": "Capacity-building and project-preparation grants (GCF Readiness, AF Readiness Grants) — funds the preparatory work rather than the adaptation project itself",
        "@id": "abv:enums-accreditation_modality-readiness_programme",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      },
      {
        "id": "not_applicable",
        "name": "Not Applicable",
        "description": "Source is outside the AF/GCF accreditation framework (e.g., commercial loan, municipal budget, private investment)",
        "@id": "abv:enums-accreditation_modality-not_applicable",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-accreditation_modality"
        }
      }
    ],
    "@id": "abv:enums-accreditation_modality",
    "@type": "skos:ConceptScheme"
  },
