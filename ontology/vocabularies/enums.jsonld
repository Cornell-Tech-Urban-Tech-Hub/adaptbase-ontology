        }
      },
      {
        "id": "federal_cost_share",
        "name": "Federal Cost Share",
        "description": "Federal funding covering a portion of project cost (e.g., FEMA BRIC, USACE cost-share, FHWA federal-aid)",
        "@id": "abv:enums-instrument_type-federal_cost_share",
        "@type": "skos:Concept",
        "skos:topConceptOf": {
          "@id": "abv:enums-instrument_type"
        }
      },
      {
        "id": "state_cost_share",
        "name": "State Cost Share",
        "description": "State funding covering a portion of project cost",
        "@id": "abv:enums-instrument_type-state_cost_share",
