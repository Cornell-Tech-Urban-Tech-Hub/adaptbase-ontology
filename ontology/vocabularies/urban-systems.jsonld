        {
          "id": "informal_service_systems",
          "name": "Informal Service Systems",
          "_note": "Service provision filled by informal actors and arrangements where formal systems are absent, insufficient, or inaccessible. Critical for modeling adaptation in cities of the Global South per IPCC AR6 Ch. 6, which observes that ISO 37120 and similar formal taxonomies miss these systems even when they serve a majority of residents.",
          "systems": [
            {
              "id": "informal_water_supply",
              "name": "Informal Water Supply",
              "examples": "Water vendors, tanker trucks, private boreholes serving communities without piped supply",
              "definition": "Water from vendors, tankers and private boreholes where there is no piped supply.",
              "@id": "abv:urban-systems-socioeconomic_health-informal_service_systems-informal_water_supply",
